# sllr-agent env. Copy to .env.local and fill in. Never commit real values.

# --- Gemini (required for CLI + server) ---
GEMINI_API_KEY=                       # https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-2.5-flash
# SLLR_BASE_URL=https://sll-r.vercel.app

# --- Sendblue iMessage server (npm run server) ---
SENDBLUE_API_KEY_ID=                  # Sendblue dashboard → Settings → API
SENDBLUE_API_SECRET=
# SENDBLUE_FROM_NUMBER=+1...          # optional; blank = Sendblue default number
# SENDBLUE_WEBHOOK_SECRET=            # optional; if set, inbound webhook must present it
# PORT=8787

# Merchant iMessage number that receives order pushes (reply 1/2/3). Blank =
# merchant push disabled (customer ordering still works).
SLLR_MERCHANT_NUMBER=+1...

# --- LINE Messaging service (npm run line-server) ---
LINE_CHANNEL_ACCESS_TOKEN=            # LINE Developers Console -> Messaging API
LINE_CHANNEL_SECRET=                  # LINE Developers Console -> Basic settings
# LINE_API_BASE_URL=https://api.line.me
# PORT=8788
