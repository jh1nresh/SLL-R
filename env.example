SLLR_PORT=3100
SLLR_PUBLIC_ORIGIN=http://localhost:3100

# Optional verifier for merchant-scoped payment proof endpoints. Without this
# secret, POST /merchants/:id/payment requires demo=true.
# SLLR_MERCHANT_PAYMENT_VERIFY_SECRET=replace-with-random-server-secret

# Optional Base MCP demo recipient. Must be a wallet you control or are willing
# to receive demo USDC payments with. Do not use a burn/random address.
# SLLR_BASE_COFFEE_RECIPIENT=0x0000000000000000000000000000000000000000

# Optional: when configured, the Jiagon receipt adapter can call a real receipt
# endpoint after payment or fulfillment proof. The scaffold keeps this as a
# no-secret stub by default.
# JIAGON_RECEIPT_API_URL=https://jiagon.vercel.app/api/merchant/receipts
# JIAGON_RECEIPT_API_KEY=replace-with-server-side-token
